// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `zed: Open Default Settings` command
// from the command palette
{
  "instrumentation": {
    "performance_profiler": {
      "enabled": false
    }
  },
  "disable_ai": true,
  "accessible_mode": true,
  "icon_theme": "VSCode Great Icons Theme",
  "mouse_wheel_zoom": true,
  "proxy": "http://localhost:3080",
  "cli_default_open_behavior": "existing_window",
  "agent_servers": {
    "claude-acp": {
      "favorite_config_option_values": {
        "mode": [
          "acceptEdits",
          "plan",
          "auto"
        ]
      },
      "type": "registry"
    },
    "gemini": {
      "type": "registry"
    }
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "debugger": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "enabled": true
  },
  "project_panel": {
    "git_status_indicator": false,
    "diagnostic_badges": false,
    "bold_folder_labels": false,
    "starts_open": true,
    "auto_reveal_entries": true,
    "indent_size": 16.0,
    "git_status": true,
    "folder_indicator": "both",
    "entry_spacing": "standard",
    "default_width": 261.0,
    "button": true,
    "dock": "left",
    "auto_fold_dirs": false
  },
  "outline_panel": {
    "folder_indicator": "chevron",
    "dock": "left",
    "file_icons": false
  },
  "preview_tabs": {
    "enabled": true
  },
  "vertical_scroll_margin": 0.0,
  "minimap": {
    "show": "always",
    "display_in": "active_editor",
    "max_width_columns": 120
  },
  "cursor_shape": "bar",
  "cursor_blink": true,
  "buffer_font_size": 14.0,
  "file_types": {
    "env": [
      "*.env.development",
      "*.env.production"
    ]
  },
  "auto_indent_on_paste": true,
  "use_on_type_format": false,
  "show_whitespaces": "all",
  "show_edit_predictions": true,
  "tab_size": 3,
  "auto_install_extensions": {
    "html": true,
    "biome": true,
    "scss": true,
    "fish": true,
    "emmet": true,
    "dockerfile": true,
    "tailwind-syntax": true,
    "docker-compose": false
  },
  "languages": {
    "TypeScript": {
      "language_servers": [
        "typescript-language-server",
        "!vtsls",
        "..."
      ],
      "auto_indent_on_paste": true,
      "use_on_type_format": true,
      "show_whitespaces": "selection",
      "show_edit_predictions": true,
      "tab_size": 3
    },
    "TSX": {
      "language_servers": [
        "typescript-language-server",
        "!vtsls",
        "..."
      ],
      "auto_indent_on_paste": true,
      "use_on_type_format": true,
      "show_whitespaces": "selection",
      "show_edit_predictions": true,
      "tab_size": 3
    },
    "JavaScript": {
      // "language_servers": ["typescript-language-server", "!vtsls", "..."]
      "auto_indent_on_paste": true,
      "use_on_type_format": true,
      "show_whitespaces": "selection",
      "show_edit_predictions": true,
      "tab_size": 3
    }
  },
  "language_servers": [
    "biome",
    "..."
  ],
  "lsp": {
    "biome": {
      "settings": {
        "config_path": "biome.json",
        "require_config_file": true
      }
    }
  },
  "formatter": {
    "language_server": {
      "name": "biome"
    }
  },
  "code_actions_on_format": {
    "source.fixAll.biome": true,
    "source.organizeImports.biome": true
  },
  "format_on_save": "on",
  "confirm_quit": true,
  "base_keymap": "VSCode",
  "language_models": {},
  "terminal": {
    "button": true,
    "max_scroll_history_lines": 50000,
    // "font_family": "",
    "font_size": 12
  },
  "theme": "VSCode Dark Modern",
  "auto_update": false
}
