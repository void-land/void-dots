#!/bin/bash
# Complete network reset script

source "$(dirname "${BASH_SOURCE[0]}")/scripts-lib.sh"

require_root

info "Resetting network configuration..."

# Stop network services
systemctl stop NetworkManager 2>/dev/null

# Flush all interfaces
for interface in $(ip -o link show | awk -F': ' '{print $2}' | grep -v lo); do
	info "Flushing $interface"
	ip addr flush dev $interface
	ip link set $interface down
done

# Flush routing tables
ip route flush table main
ip route flush cache

# Remove all TUN/TAP interfaces
for tun in $(ip link show | grep tun | cut -d: -f2 | tr -d ' '); do
	ip link delete $tun 2>/dev/null
done

# Clear iptables rules
iptables -F
iptables -t nat -F
iptables -t mangle -F
iptables -X

# Restart network services
systemctl start NetworkManager 2>/dev/null

success "Network reset complete. Waiting for network to come back up..."
sleep 5

# Show current status
ip addr show
