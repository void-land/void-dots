#!/bin/bash
source "$HOME/.ucu/ucu-launcher-lib.sh"

# ==============================================================================
# GAME CONFIGURATION
# ==============================================================================
GAME_NAME="Cyberpunk 2077"
GAME_DIR="$HOME/Games/cyberpunk-2077"
GAME_EXE="$GAME_DIR/bin/x64/Cyberpunk2077.exe"
WINE_PREFIX="$HOME/Games/.umu-prefixes/cyberpunk"

# ==============================================================================
# UMU / PROTON IDENTITY
#
# GAMEID / STEAM_APP_ID
#   These tell umu-launcher which Proton fixes to apply. Using the real Steam
#   App ID (instead of "umu-default") pulls in game-specific patches even for
#   non-Steam copies — umu only uses the ID for fix lookups
#
#   How to find the Steam App ID:
#     1. Go to https://www.protondb.com and search for your game.
#     2. Open the game's page — the App ID is in the URL:
#            protondb.com/app/1091500   →   App ID is 1091500
#
#   Using "steam-default" / "0" disables fix lookups (fine for testing, but
#   you'll miss any game-specific workarounds).
# ==============================================================================
STEAM_APP_ID="0"
GAMEID="steam-default"
PROTONPATH="$HOME/.local/share/Steam/compatibilitytools.d/GE-Proton11-3"
# GAME_ARGS="/WineDetectionEnabled:False"

# ==============================================================================
# GAME-SPECIFIC ENVIRONMENT OVERRIDES
#
# This hook runs before launch. Uncomment and adjust only what you need —
# leaving unused options commented out keeps things easy to read and debug.
# ==============================================================================
umu_env_hook() {
	# --------------------------------------------------------------------------
	# Performance
	# --------------------------------------------------------------------------
	export PROTON_GAMEMODE=1
	export PROTON_USE_NTSYNC=1
	export PROTON_FORCE_LARGE_ADDRESS_AWARE=1

	# --------------------------------------------------------------------------
	# Sync primitives
	# --------------------------------------------------------------------------
	# export PROTON_NO_NTSYNC=1
	# export PROTON_NO_ESYNC=1
	# export PROTON_NO_FSYNC=1
	# export PROTONFIXES_DISABLE=1
	# export WINEDLLOVERRIDES=""

	# --------------------------------------------------------------------------
	# Display / Wayland
	# --------------------------------------------------------------------------
	export PROTON_ENABLE_HDR=0
	export PROTON_ENABLE_WAYLAND=1

	# --------------------------------------------------------------------------
	# FSR 4 (AMD FidelityFX Super Resolution 4)
	# Requires an AMD RDNA 4 GPU (RX 9000 series). Has no effect otherwise.
	# --------------------------------------------------------------------------
	export PROTON_FSR4_UPGRADE=0
	export PROTON_FSR4_INDICATOR=0

	# --------------------------------------------------------------------------
	# Graphics — DXVK / VKD3D-Proton
	# --------------------------------------------------------------------------
	# export DXVK_ASYNC=1
	# export DXVK_FRAME_RATE=120
	# export RADV_PERFTEST=gpl
	# export VKD3D_CONFIG=dxr

	# --------------------------------------------------------------------------
	# Overlay
	# --------------------------------------------------------------------------
	export MANGOHUD=1
	# export MANGOHUD_CONFIG="full,vsync=1,font_size=16,font_scale=1.0"

	# --------------------------------------------------------------------------
	# Debugging
	# --------------------------------------------------------------------------
	# export PROTON_LOG=1
}

umu_launch_game