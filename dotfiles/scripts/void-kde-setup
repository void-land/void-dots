#!/bin/bash

# ─────────────────────────────────────────────
#  KDE Setup — apply dotfiles/kde/settings.conf
# ─────────────────────────────────────────────
# KDE rewrites its rc files during normal use, so they aren't stowed.
# Instead the settings worth keeping live in dotfiles/kde/settings.conf and this
# script writes them with kwriteconfig6, reloading KWin over D-Bus where
# it can. Safe to re-run: every step is idempotent.

SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
source "$SCRIPT_DIR/scripts-lib.sh"

KDE_SETTINGS="$SCRIPT_DIR/../kde/settings.conf"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
SESSION_ENV_FILE="$CONFIG_HOME/plasma-workspace/env/void-env.sh"

# Steps run in this order. Names (for -o), picker labels and functions are
# paired by index.
STEP_NAMES=(env theme config desktops effects shortcuts mime eos panel)
STEP_DESCS=(
	"Session env (plasma-workspace/env, next login)"
	"Theme (look-and-feel, color scheme)"
	"Config keys (layouts, mouse, power, Dolphin…)"
	"Virtual desktops"
	"KWin effects (magic lamp, blur…)"
	"Shortcuts (next login)"
	"Default applications"
	"EndeavourOS welcome"
	"Panel (restarts plasmashell)"
)
STEP_FUNCS=(
	apply_env
	apply_theme
	apply_config
	apply_desktops
	apply_effects
	apply_shortcuts
	apply_mime
	apply_eos
	apply_panel
)

DRY_RUN=false
NO_RESTART=false
KWIN_UP=false
DRIFT=0

# ─────────────────────────────────────────────
#  Helpers
# ─────────────────────────────────────────────

# run CMD... — executes CMD, or just prints it in dry-run mode
run() {
	if $DRY_RUN; then
		printf '[dry-run]'
		printf ' %q' "$@"
		echo
	else
		"$@"
	fi
}

# group_args GROUPPATH — prints "--group A --group B" (NUL-separated) for A/B
group_args() {
	local -a groups
	local g
	IFS=/ read -ra groups <<<"$1"
	for g in "${groups[@]}"; do
		printf '%s\0%s\0' --group "$g"
	done
}

# kde_read FILE GROUPPATH KEY
kde_read() {
	local -a args
	mapfile -d '' args < <(group_args "$2")
	kreadconfig6 --file "$1" "${args[@]}" --key "$3"
}

# kde_write FILE GROUPPATH KEY VALUE — a literal \t in VALUE becomes a tab,
# which kconfig stores escaped as \t (the alternate-shortcut separator)
kde_write() {
	local -a args
	mapfile -d '' args < <(group_args "$2")
	run kwriteconfig6 --notify --file "$1" "${args[@]}" --key "$3" "${4//\\t/$'\t'}"
}

# kwin_call PATH INTERFACE METHOD [SIGNATURE ARGS...]
kwin_call() {
	local path="$1" iface="$2" method="$3"
	shift 3
	run busctl --user call org.kde.KWin "$path" "$iface" "$method" "$@" >/dev/null
}

kwin_desktops_json() {
	busctl --user --json=short get-property org.kde.KWin /VirtualDesktopManager \
		org.kde.KWin.VirtualDesktopManager desktops
}

# drift WHAT WANT HAVE — records and prints a mismatch for -c
drift() {
	DRIFT=$((DRIFT + 1))
	printf '  ✗ %s\n      want: %s\n      have: %s\n' "$1" "$2" "${3:-<unset>}"
}

check_eq() {
	[[ "$2" == "$3" ]] || drift "$1" "$2" "$3"
}

# ─────────────────────────────────────────────
#  Steps
# ─────────────────────────────────────────────

session_env_content() {
	local entry
	echo "# Generated by void-kde-setup from dotfiles/kde/settings.conf — edit that instead."
	for entry in "${KDE_SESSION_ENV[@]}"; do
		printf 'export %s=%q\n' "${entry%%=*}" "${entry#*=}"
	done
}

apply_env() {
	if $DRY_RUN; then
		echo "[dry-run] write $SESSION_ENV_FILE:"
		session_env_content | sed 's/^/    /'
		return
	fi
	mkdir -p "$(dirname "$SESSION_ENV_FILE")"
	session_env_content >"$SESSION_ENV_FILE"
	success "Session env written to $SESSION_ENV_FILE (applies at next login)."
}

apply_theme() {
	kde_write kdeglobals KDE LookAndFeelPackage "$KDE_LOOK_AND_FEEL"
	# Not plasma-apply-lookandfeel: that can replace the panel layout.
	if command -v plasma-apply-colorscheme &>/dev/null; then
		run plasma-apply-colorscheme "$KDE_COLOR_SCHEME" || true
	else
		warn "plasma-apply-colorscheme not found; color scheme not applied."
	fi
}

apply_config() {
	local entry file group key value
	for entry in "${KDE_CONFIG[@]}"; do
		IFS='|' read -r file group key value <<<"$entry"
		kde_write "$file" "$group" "$key" "$value"
	done

	if $KWIN_UP; then
		kwin_call /KWin org.kde.KWin reconfigure
		run busctl --user emit /Layouts org.kde.keyboard reloadConfig
		# KGlobalSettings::SettingsChanged
		run busctl --user emit /KGlobalSettings org.kde.KGlobalSettings notifyChange ii 3 0
	fi
	success "${#KDE_CONFIG[@]} config keys written."
}

apply_desktops_offline() {
	local i id
	kde_write kwinrc Desktops Number "${#KDE_DESKTOPS[@]}"
	kde_write kwinrc Desktops Rows "$KDE_DESKTOP_ROWS"
	for i in "${!KDE_DESKTOPS[@]}"; do
		id="$(kde_read kwinrc Desktops "Id_$((i + 1))")"
		[[ -n "$id" ]] || kde_write kwinrc Desktops "Id_$((i + 1))" "$(uuidgen)"
		kde_write kwinrc Desktops "Name_$((i + 1))" "${KDE_DESKTOPS[$i]}"
	done
}

apply_desktops() {
	local want="${#KDE_DESKTOPS[@]}"
	if ! $KWIN_UP; then
		apply_desktops_offline
		success "$want desktops written to kwinrc (KWin not running)."
		return
	fi

	local -a ids
	mapfile -t ids < <(kwin_desktops_json | jq -r '.data | sort_by(.[0]) | .[][1]')

	local i
	for ((i = ${#ids[@]}; i < want; i++)); do
		kwin_call /VirtualDesktopManager org.kde.KWin.VirtualDesktopManager \
			createDesktop us "$i" "${KDE_DESKTOPS[$i]}"
	done
	for ((i = ${#ids[@]} - 1; i >= want; i--)); do
		kwin_call /VirtualDesktopManager org.kde.KWin.VirtualDesktopManager \
			removeDesktop s "${ids[$i]}"
	done

	$DRY_RUN || mapfile -t ids < <(kwin_desktops_json | jq -r '.data | sort_by(.[0]) | .[][1]')
	for ((i = 0; i < want && i < ${#ids[@]}; i++)); do
		kwin_call /VirtualDesktopManager org.kde.KWin.VirtualDesktopManager \
			setDesktopName ss "${ids[$i]}" "${KDE_DESKTOPS[$i]}"
	done
	run busctl --user set-property org.kde.KWin /VirtualDesktopManager \
		org.kde.KWin.VirtualDesktopManager rows u "$KDE_DESKTOP_ROWS"

	success "Desktops: ${KDE_DESKTOPS[*]}."
}

apply_effects() {
	local effect
	for effect in "${KWIN_EFFECTS_ENABLE[@]}"; do
		kde_write kwinrc Plugins "${effect}Enabled" true
		$KWIN_UP && kwin_call /Effects org.kde.kwin.Effects loadEffect s "$effect"
	done
	for effect in "${KWIN_EFFECTS_DISABLE[@]}"; do
		kde_write kwinrc Plugins "${effect}Enabled" false
		$KWIN_UP && kwin_call /Effects org.kde.kwin.Effects unloadEffect s "$effect"
	done
	success "Effects on: ${KWIN_EFFECTS_ENABLE[*]}; off: ${KWIN_EFFECTS_DISABLE[*]}."
}

# shortcut_value COMPONENT ACTION KEYS — "keys,default,description", keeping
# whatever default/description kglobalaccel already recorded
shortcut_value() {
	local current default desc
	current="$(kde_read kglobalshortcutsrc "$1" "$2")"
	if [[ "$current" == *,*,* ]]; then
		desc="${current##*,}"
		current="${current%,*}"
		default="${current##*,}"
	fi
	echo "$3,${default:-none},${desc:-$2}"
}

apply_shortcuts() {
	local entry component action keys
	for entry in "${KDE_SHORTCUTS[@]}"; do
		IFS='|' read -r component action keys <<<"$entry"
		if [[ "$component" == services/* ]]; then
			kde_write kglobalshortcutsrc "$component" "$action" "$keys"
		else
			kde_write kglobalshortcutsrc "$component" "$action" "$(shortcut_value "$component" "$action" "$keys")"
		fi
	done
	success "${#KDE_SHORTCUTS[@]} shortcuts written."
	warn "kglobalaccel lives inside KWin and has no reload: shortcuts apply at next login."
}

# Written with kconfig like KDE itself does; xdg-mime's KDE path needs a
# Qt5-era `qtpaths` that Plasma 6 systems don't ship.
apply_mime() {
	local entry
	for entry in "${KDE_MIME_DEFAULTS[@]}"; do
		kde_write mimeapps.list "Default Applications" "${entry%%=*}" "${entry#*=}"
	done
	success "${#KDE_MIME_DEFAULTS[@]} default applications set."
}

# set_shell_kv FILE KEY VALUE — sets KEY=VALUE in a bash-syntax config file,
# keeping any trailing comment; appends the key when it's missing
set_shell_kv() {
	local file="$1" key="$2" value="$3"
	if [[ -f "$file" ]] && grep -q "^${key}=" "$file"; then
		run sed -i "s|^${key}=[^ #]*|${key}=${value}|" "$file"
	elif $DRY_RUN; then
		echo "[dry-run] append ${key}=${value} to $file"
	else
		echo "${key}=${value}" >>"$file"
	fi
}

apply_eos() {
	if ! command -v eos-welcome &>/dev/null; then
		info "eos-welcome not installed; skipping."
		return
	fi
	set_shell_kv "$CONFIG_HOME/EOS-greeter.conf" Greeter "$EOS_GREETER"
	set_shell_kv "$CONFIG_HOME/EOS-greeter.conf" OnceDaily "$EOS_GREETER_ONCE_DAILY"
	set_shell_kv "$CONFIG_HOME/welcome.conf" EOS_WELCOME_ACTIVE_TAB_NUMBER "$EOS_WELCOME_ACTIVE_TAB"
	success "EndeavourOS welcome: greeter ${EOS_GREETER}."
}

apply_panel() {
	if $NO_RESTART; then
		run "$SCRIPT_DIR/void-kde-panel" -R
	else
		run "$SCRIPT_DIR/void-kde-panel"
	fi
}

# ─────────────────────────────────────────────
#  Drift check
# ─────────────────────────────────────────────

check_drift() {
	local entry file group key value component action keys effect

	info "Config keys"
	for entry in "${KDE_CONFIG[@]}"; do
		IFS='|' read -r file group key value <<<"$entry"
		check_eq "$file [$group] $key" "$value" "$(kde_read "$file" "$group" "$key")"
	done
	check_eq "kdeglobals [KDE] LookAndFeelPackage" "$KDE_LOOK_AND_FEEL" \
		"$(kde_read kdeglobals KDE LookAndFeelPackage)"
	check_eq "kdeglobals [General] ColorScheme" "$KDE_COLOR_SCHEME" \
		"$(kde_read kdeglobals General ColorScheme)"

	info "Shortcuts"
	for entry in "${KDE_SHORTCUTS[@]}"; do
		IFS='|' read -r component action keys <<<"$entry"
		value="$(kde_read kglobalshortcutsrc "$component" "$action")"
		[[ "$component" == services/* ]] || value="${value%%,*}"
		check_eq "[$component] $action" "$keys" "${value//$'\t'/\\t}"
	done

	info "Effects"
	for effect in "${KWIN_EFFECTS_ENABLE[@]}"; do
		check_eq "kwinrc [Plugins] ${effect}Enabled" true "$(kde_read kwinrc Plugins "${effect}Enabled")"
	done
	for effect in "${KWIN_EFFECTS_DISABLE[@]}"; do
		check_eq "kwinrc [Plugins] ${effect}Enabled" false "$(kde_read kwinrc Plugins "${effect}Enabled")"
	done

	info "Desktops"
	if $KWIN_UP; then
		check_eq "virtual desktops" "${KDE_DESKTOPS[*]}" \
			"$(kwin_desktops_json | jq -r '[.data | sort_by(.[0]) | .[][2]] | join(" ")')"
	fi
	check_eq "kwinrc [Desktops] Rows" "$KDE_DESKTOP_ROWS" "$(kde_read kwinrc Desktops Rows)"

	info "Default applications"
	for entry in "${KDE_MIME_DEFAULTS[@]}"; do
		check_eq "mimeapps.list ${entry%%=*}" "${entry#*=}" \
			"$(kde_read mimeapps.list "Default Applications" "${entry%%=*}")"
	done

	info "Session env"
	check_eq "$SESSION_ENV_FILE" "$(session_env_content)" "$(cat "$SESSION_ENV_FILE" 2>/dev/null)"

	echo
	if ((DRIFT)); then
		warn "$DRIFT setting(s) differ from dotfiles/kde/settings.conf."
		warn "Update settings.conf to keep them, or run $(basename "$0") to restore."
		return 1
	fi
	success "Live desktop matches dotfiles/kde/settings.conf."
}

# ─────────────────────────────────────────────
#  Main
# ─────────────────────────────────────────────

usage() {
	cat <<EOF

  Usage: $(basename "$0") [OPTIONS]

  Options:
    -o <steps>  Run only these steps, comma-separated (see -l)
    -y          Apply every step without the picker
    -n          Dry run: print what would be written
    -R          Don't restart plasmashell after the panel step
    -c          Check drift: compare the live desktop to settings.conf
    -l          List steps, then exit
    -h          Show this help

  Without -o/-y, a picker lists the steps and asks which to exclude
  (Enter runs them all). With no terminal it applies every step.

  Settings: dotfiles/kde/settings.conf

  Examples:
    $(basename "$0")                     # pick steps to exclude, apply the rest
    $(basename "$0") -y                  # apply everything
    $(basename "$0") -o shortcuts,effects
    $(basename "$0") -c                  # what changed in System Settings?

EOF
	exit 0
}

# step_index NAME — prints NAME's index in STEP_NAMES
step_index() {
	local i
	for i in "${!STEP_NAMES[@]}"; do
		[[ "${STEP_NAMES[$i]}" == "$1" ]] && echo "$i" && return 0
	done
	return 1
}

main() {
	local only="" check=false all=false opt i

	while getopts "o:ynRclh" opt; do
		case $opt in
		o) only="$OPTARG" ;;
		y) all=true ;;
		n) DRY_RUN=true ;;
		R) NO_RESTART=true ;;
		c) check=true ;;
		l)
			for i in "${!STEP_NAMES[@]}"; do
				printf '  %-10s %s\n' "${STEP_NAMES[$i]}" "${STEP_DESCS[$i]}"
			done
			exit 0
			;;
		h) usage ;;
		*) usage ;;
		esac
	done

	[[ -f "$KDE_SETTINGS" ]] || die "Settings not found: $KDE_SETTINGS"
	# shellcheck source=../kde/settings.conf
	source "$KDE_SETTINGS"

	command -v kwriteconfig6 &>/dev/null || die "kwriteconfig6 not found (install kconfig)."
	command -v jq &>/dev/null || die "jq not found."

	if busctl --user status org.kde.KWin &>/dev/null; then
		KWIN_UP=true
	else
		warn "KWin isn't running in this session; writing config only, no live reload."
	fi

	if $check; then
		check_drift
		exit
	fi

	local -a run_idx=()
	if [[ -n "$only" ]]; then
		local name idx
		local -a names
		IFS=, read -ra names <<<"$only"
		for name in "${names[@]}"; do
			idx="$(step_index "$name")" || die "Unknown step: '$name' (see -l)."
			run_idx+=("$idx")
		done
	elif $all || [[ ! -t 0 ]]; then
		run_idx=("${!STEP_NAMES[@]}")
	else
		local -A excluded_steps=()
		select_exclusions STEP_DESCS "steps" excluded_steps
		for i in "${!STEP_NAMES[@]}"; do
			if [[ -n "${excluded_steps[$((i + 1))]}" ]]; then
				echo -e "${C_RED}[-]${C_NC} Skipping: ${STEP_DESCS[$i]}"
				continue
			fi
			run_idx+=("$i")
		done
	fi

	for i in "${run_idx[@]}"; do
		echo
		info "── ${STEP_DESCS[$i]}"
		"${STEP_FUNCS[$i]}"
	done
}

main "$@"
