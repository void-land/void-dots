#!/bin/bash
# void-arch-mirror-test — benchmark Arch mirrors (latency, sync age,
# download speed), score them and print a ranked table, best first.

source "$(dirname "${BASH_SOURCE[0]}")/scripts-lib.sh"

# ─────────────────────────────────────────────
#  Config
# ─────────────────────────────────────────────

# pacman-style templates; $repo/$arch are filled in per request
# shellcheck disable=SC2016
MIRRORS=(
	'http://mirror.famaserver.com/archlinux/$repo/os/$arch'
	'https://mirror.famaserver.com/archlinux/$repo/os/$arch'
	'http://repo.iut.ac.ir/repo/archlinux/$repo/os/$arch'
	'http://mirror.mobinhost.com/archlinux/$repo/os/$arch'
	'https://mirror.mobinhost.com/archlinux/$repo/os/$arch'
)

ARCH="x86_64"
TIMEOUT=10        # speed-test cap per mirror (-t)
CONNECT_TIMEOUT=5 # TCP/TLS connect cap for every request
STALE_AFTER=86400 # sync age (s) that gets flagged as stale

# score weights (sum to 100)
W_SPEED=65
W_TTFB=25
W_FRESH=10

C_YELLOW='\033[0;33m'

# per-mirror results, indexed in step with the mirror list
R_URL=()
R_STATUS=() # OK | FAIL
R_NOTE=()
R_CONNECT=() # ms
R_TTFB=()    # ms
R_AGE=()     # seconds since last sync, empty when unknown
R_SPEED=()   # bytes/s
R_SCORE=()

# ─────────────────────────────────────────────
#  Helpers
# ─────────────────────────────────────────────

usage() {
	cat <<EOF
Usage: $(basename "$0") [-t <sec>] [-f <mirrorlist>] [-m] [-h]

Benchmark Arch mirrors and rank them by a 0-100 score:
  ${W_SPEED}% download speed, ${W_TTFB}% time-to-first-byte, ${W_FRESH}% sync freshness.

Options:
  -t <sec>   Speed-test time cap per mirror (default: $TIMEOUT)
  -f <file>  Test the Server lines of a mirrorlist file instead of the
             built-in list (commented "#Server =" lines are accepted too)
  -m         Also print the ranked list as "Server = ..." lines
  -h         Show this help
EOF
}

# expand_url URL REPO — fill pacman's $repo/$arch placeholders
expand_url() {
	local url="${1//\$repo/$2}"
	printf '%s\n' "${url//\$arch/$ARCH}"
}

# mirror_root URL — everything before $repo (keeps the trailing slash)
mirror_root() { printf '%s\n' "${1%%\$repo*}"; }

host_of() {
	local h="${1#*://}"
	printf '%s\n' "${h%%/*}"
}

proto_of() { printf '%s\n' "${1%%://*}"; }

# fmt_age SECONDS — 42m / 5h / 3d, "?" when unknown
fmt_age() {
	local s="$1"
	if [[ -z $s ]]; then
		printf '?'
	elif ((s < 3600)); then
		printf '%dm' $((s / 60))
	elif ((s < 86400)); then
		printf '%dh' $((s / 3600))
	else
		printf '%dd' $((s / 86400))
	fi
}

# fmt_speed BYTES_PER_SEC
fmt_speed() {
	awk -v b="$1" 'BEGIN {
		if (b >= 1048576) printf "%.2f MB/s", b / 1048576
		else printf "%.0f KB/s", b / 1024
	}'
}

# load_mirrorlist FILE — replace MIRRORS with the file's Server lines
load_mirrorlist() {
	[[ -r $1 ]] || die "Cannot read $1"
	mapfile -t MIRRORS < <(
		grep -E '^[[:space:]]*#?[[:space:]]*Server[[:space:]]*=' "$1" |
			sed -E 's/^[^=]*=[[:space:]]*//; s/[[:space:]]+$//'
	)
	((${#MIRRORS[@]})) || die "No Server lines found in $1"
}

# ─────────────────────────────────────────────
#  Tests
# ─────────────────────────────────────────────

# test_mirror INDEX URL — fills the R_* arrays at INDEX
test_mirror() {
	local i="$1" url="$2" out code connect ttfb stamp speed size

	R_URL[i]="$url"
	R_STATUS[i]="FAIL"
	R_NOTE[i]=""
	R_AGE[i]=""
	R_SPEED[i]=0
	R_CONNECT[i]=0
	R_TTFB[i]=0

	# 1. latency: HEAD on the small core.db
	out=$(curl -sI -o /dev/null --connect-timeout "$CONNECT_TIMEOUT" --max-time "$TIMEOUT" \
		-w '%{http_code} %{time_connect} %{time_starttransfer}' \
		"$(expand_url "$url" core)/core.db" 2>/dev/null)
	read -r code connect ttfb <<<"$out"
	if [[ ${code:-000} == 000 ]]; then
		R_NOTE[i]="unreachable"
		return
	elif [[ ! $code =~ ^[23] ]]; then
		R_NOTE[i]="HTTP $code"
		return
	fi
	R_CONNECT[i]=$(awk -v s="$connect" 'BEGIN { printf "%.0f", s * 1000 }')
	R_TTFB[i]=$(awk -v s="$ttfb" 'BEGIN { printf "%.0f", s * 1000 }')

	# 2. freshness: unix timestamp of the mirror's last sync
	stamp=$(curl -s --connect-timeout "$CONNECT_TIMEOUT" --max-time 5 \
		"$(mirror_root "$url")lastupdate" 2>/dev/null)
	if [[ $stamp =~ ^[0-9]+$ ]]; then
		R_AGE[i]=$((NOW - stamp))
		((R_AGE[i] < 0)) && R_AGE[i]=0
	fi

	# 3. speed: extra.db (~8 MB); a timed-out transfer still reports its average
	out=$(curl -s -o /dev/null --connect-timeout "$CONNECT_TIMEOUT" --max-time "$TIMEOUT" \
		-w '%{http_code} %{speed_download} %{size_download}' \
		"$(expand_url "$url" extra)/extra.db" 2>/dev/null)
	read -r code speed size <<<"$out"
	if [[ ! ${code:-000} =~ ^2 ]] || [[ ${size:-0} == 0 ]]; then
		R_NOTE[i]="download failed (HTTP ${code:-000})"
		return
	fi
	R_SPEED[i]=$(awk -v s="$speed" 'BEGIN { printf "%.0f", s }')
	R_STATUS[i]="OK"
	((R_AGE[i] > STALE_AFTER)) && R_NOTE[i]="stale"
}

# ─────────────────────────────────────────────
#  Scoring / Output
# ─────────────────────────────────────────────

# score_mirrors — speed and TTFB are scored relative to the best mirror
score_mirrors() {
	local i max_speed=0 min_ttfb=0

	for i in "${!R_URL[@]}"; do
		[[ ${R_STATUS[i]} == OK ]] || continue
		((R_SPEED[i] > max_speed)) && max_speed=${R_SPEED[i]}
		if ((min_ttfb == 0 || (R_TTFB[i] > 0 && R_TTFB[i] < min_ttfb))); then
			min_ttfb=${R_TTFB[i]}
		fi
	done

	for i in "${!R_URL[@]}"; do
		if [[ ${R_STATUS[i]} != OK ]]; then
			R_SCORE[i]=-1
			continue
		fi
		R_SCORE[i]=$(awk -v s="${R_SPEED[i]}" -v ms="$max_speed" \
			-v t="${R_TTFB[i]}" -v mt="$min_ttfb" -v age="${R_AGE[i]}" \
			-v ws="$W_SPEED" -v wt="$W_TTFB" -v wf="$W_FRESH" 'BEGIN {
				sp = (ms > 0) ? s / ms : 0
				tt = (t > 0) ? mt / t : 1
				if (age == "") fr = 0.5
				else if (age <= 21600) fr = 1
				else if (age >= 172800) fr = 0
				else fr = 1 - (age - 21600) / (172800 - 21600)
				printf "%.0f", ws * sp + wt * tt + wf * fr
			}')
	done
}

# print_table — ranked table, best first
print_table() {
	local i rank=0 color score

	echo
	printf "${C_BLUE}%-3s %-6s %-11s %-7s %-8s %-7s %-6s %-30s %s${C_NC}\n" \
		"#" "Score" "Speed" "TTFB" "Connect" "Synced" "Proto" "Host" "Note"
	printf '%s\n' "$(printf '─%.0s' $(seq 1 96))"

	for i in "${RANKED[@]}"; do
		((rank++))
		color=""
		if [[ ${R_STATUS[i]} != OK ]]; then
			color=$C_RED
		elif ((rank == 1)); then
			color=$C_GREEN
		elif [[ ${R_NOTE[i]} == stale ]]; then
			color=$C_YELLOW
		fi

		if [[ ${R_STATUS[i]} == OK ]]; then
			score=${R_SCORE[i]}
			printf "%b%-3s %-6s %-11s %-7s %-8s %-7s %-6s %-30s %s%b\n" "$color" \
				"$rank" "$score" "$(fmt_speed "${R_SPEED[i]}")" "${R_TTFB[i]}ms" \
				"${R_CONNECT[i]}ms" "$(fmt_age "${R_AGE[i]}")" "$(proto_of "${R_URL[i]}")" \
				"$(host_of "${R_URL[i]}")" "$( ((rank == 1)) && echo "★ best")${R_NOTE[i]:+ ${R_NOTE[i]}}" "$C_NC"
		else
			printf "%b%-3s %-6s %-11s %-7s %-8s %-7s %-6s %-30s %s%b\n" "$color" \
				"$rank" "-" "-" "-" "-" "-" "$(proto_of "${R_URL[i]}")" \
				"$(host_of "${R_URL[i]}")" "${R_NOTE[i]}" "$C_NC"
		fi
	done
	echo
}

# ─────────────────────────────────────────────
#  Main
# ─────────────────────────────────────────────

PRINT_LIST=0

while getopts ":t:f:mh" opt; do
	case $opt in
	t)
		[[ $OPTARG =~ ^[0-9]+$ ]] && ((OPTARG > 0)) || die "-t needs a positive number of seconds"
		TIMEOUT=$OPTARG
		;;
	f) load_mirrorlist "$OPTARG" ;;
	m) PRINT_LIST=1 ;;
	h)
		usage
		exit 0
		;;
	:) die "Option -$OPTARG requires an argument" ;;
	*)
		usage >&2
		exit 1
		;;
	esac
done

command -v curl >/dev/null || die "curl is required"

NOW=$(date +%s)
info "Testing ${#MIRRORS[@]} mirrors (speed cap ${TIMEOUT}s each)..."

for idx in "${!MIRRORS[@]}"; do
	printf '[*] %-36s ' "$(host_of "${MIRRORS[idx]}") ($(proto_of "${MIRRORS[idx]}"))"
	test_mirror "$idx" "${MIRRORS[idx]}"
	if [[ ${R_STATUS[idx]} == OK ]]; then
		echo -e "${C_GREEN}ok${C_NC}  $(fmt_speed "${R_SPEED[idx]}"), ${R_TTFB[idx]}ms TTFB"
	else
		echo -e "${C_RED}fail${C_NC}  ${R_NOTE[idx]}"
	fi
done

score_mirrors
mapfile -t RANKED < <(
	for idx in "${!R_URL[@]}"; do
		printf '%s\t%s\n' "${R_SCORE[idx]}" "$idx"
	done | sort -t$'\t' -k1,1nr | cut -f2
)
print_table

best=${RANKED[0]}
if [[ ${R_STATUS[best]} != OK ]]; then
	die "No mirror responded."
fi
success "Best mirror: $(host_of "${R_URL[best]}") ($(proto_of "${R_URL[best]}")), score ${R_SCORE[best]}/100"
echo "    Server = ${R_URL[best]}"

if ((PRINT_LIST)); then
	echo
	info "Ranked mirrorlist:"
	for idx in "${RANKED[@]}"; do
		[[ ${R_STATUS[idx]} == OK ]] && echo "Server = ${R_URL[idx]}"
	done
fi
